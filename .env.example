# Internal integration token from https://www.notion.so/my-integrations
NOTION_TOKEN=
# Page that holds StudyPilot (share it with your integration). Used by setup and sync.
NOTION_PARENT_PAGE_ID=
# Your Assignments database ID (printed by `npm run setup`, or copy from the database URL)
NOTION_DATABASE_ID=
# How many hours you usually study per day
STUDY_HOURS_PER_DAY=4
PORT=3000
